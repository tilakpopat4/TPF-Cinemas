# =====================================================================
# TPF Cinemas Backend - Environment Variables
# =====================================================================

# Environment mode ('development' | 'staging' | 'production')
ENVIRONMENT=development

# Supabase Mumbai Project (ap-south-1)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-only service_role key. NEVER expose to client applications!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cloudflare Edge Cache Purging
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-with-cache-purge-permission

# Transactional Email (Resend or Brevo)
RESEND_API_KEY=re_123456789
EMAIL_FROM="TPF Cinemas <notifications@tpfcinemas.com>"

# Webhook Security
# Shared secret to authenticate Supabase / video host webhooks
WEBHOOK_SECRET=your-secure-random-webhook-secret
